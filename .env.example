# Frontend (Next.js) environment. Copy to .env.local for local development; set the same names in Vercel.

# Local development: talk to the backend directly.
NEXT_PUBLIC_BACKEND_API_URL=http://localhost:4000
BACKEND_API_URL=http://localhost:4000

# Vercel (same-origin proxy): set ONLY BACKEND_API_URL to the Render URL and leave
# NEXT_PUBLIC_BACKEND_API_URL unset. The browser then calls /api/* on the Vercel domain.
# BACKEND_API_URL=https://haat-backend.onrender.com

# Used for sitemap/robots; set to the real site URL when known.
# NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app
