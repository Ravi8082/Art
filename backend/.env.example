NODE_ENV=development
PORT=4000
FRONTEND_ORIGIN=http://localhost:3000
# Database. DB_* names are preferred; legacy MYSQL_* names are still accepted.
# Local MySQL: DB_HOST=127.0.0.1, DB_PORT=3306, DB_NAME=art, DB_SSL=false
# Aiven MySQL: set host/port/name/user/password from the Aiven console, DB_SSL=true and DB_SSL_CA to the CA certificate.
DB_HOST=your-mysql-host
DB_PORT=3306
DB_NAME=your-database-name
DB_SSL=false
# Path to Aiven's CA certificate (relative to backend/), or DB_SSL_CA_PEM with the PEM text (use \n for newlines).
DB_SSL_CA=certs/aiven-ca.pem
# Integration tests must use a disposable database, never production data.
TEST_MYSQL_DATABASE=your-test-database-name
TEST_NODE_ENV=test
MAIL_MODE=log
# MAIL_MODE=brevo sends through Brevo's HTTPS API (works on hosts that block SMTP, e.g. Render free).
# With any other MAIL_MODE, SMTP is used only when SMTP_HOST is set. A Brevo key alone never enables sending.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=The Haat of Art
DB_USER=your-database-user
DB_PASSWORD=your-database-password
JWT_SECRET=replace-with-at-least-32-random-characters
COOKIE_SECRET=replace-with-at-least-32-random-characters
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@example.com
# WhatsApp Cloud API (Meta). Leave empty to disable automatic WhatsApp messages.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Optional approved template with one body variable ({{1}}); needed to message users outside the 24h window.
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en
# Google reviews on the homepage (Places API New). Leave empty to disable.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
GOOGLE_REVIEWS_TTL_MINUTES=360
